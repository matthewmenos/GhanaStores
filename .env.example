# ---- App ----
NODE_ENV=development
APP_NAME="Ghana Stores"
APP_BASE_DOMAIN=ghanastores.com
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---- Postgres (Vercel's built-in Neon integration) ----
# Attach the "Neon" storage integration to your Vercel project (Storage tab)
# and these are injected automatically into every environment — you should
# NOT need to set them by hand in production. For local dev, run
# `vercel env pull .env` to copy them down, or paste the pooled connection
# string from the Vercel/Neon dashboard here.
POSTGRES_URL=postgres://user:password@ep-xxxx-pooler.neon.tech/ghana_stores?sslmode=require
POSTGRES_URL_NON_POOLING=postgres://user:password@ep-xxxx.neon.tech/ghana_stores?sslmode=require

# ---- Hubtel (Payments + MoMo Disbursements) ----
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret
HUBTEL_MERCHANT_ACCOUNT_NUMBER=your_hubtel_merchant_number
HUBTEL_CALLBACK_URL=https://ghanastores.com/api/payouts/webhook
HUBTEL_BASE_URL=https://api.hubtel.com

# ---- Arkesel (Transactional SMS) ----
ARKESEL_API_KEY=your_arkesel_api_key
ARKESEL_SENDER_ID=GhanaStores
ARKESEL_BASE_URL=https://sms.arkesel.com/api/v2

# ---- Billing ----
TRIAL_LENGTH_DAYS=14
GRACE_PERIOD_DAYS=3
PAYOUT_AUTO_APPROVE_THRESHOLD_GHS=5000

# ---- Vercel Cron ----
# Vercel sends `Authorization: Bearer $CRON_SECRET` on scheduled invocations
# of /api/cron/billing when this is set — set it in Project Settings > Env Vars.
CRON_SECRET=replace-with-a-long-random-secret
