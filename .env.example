# ============================================================
# DIDWA - Environment Configuration
# Copy to .env and fill in real credentials for production.
# Every integrations degrades gracefully to DRY_RUN mode when
# credentials are absent, so local development works out of the box.
# ============================================================

# --- Core ---
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
# Apex domain used for tenant subdomains and by the Host-header resolver.
# In production this is your real domain (didwaghana.com); for local dev
# keep localhost:5173 so *.lvh.me / localhost traffic is never tenanted.
ROOT_DOMAIN=didwaghana.com
PLATFORM_DOMAIN=didwaghana.com
# Public origin used to build PDF receipt / verification links.
PLATFORM_URL=https://didwaghana.com
# CNAME target shown to sellers connecting their own domain. Vercel-hosted
# deployments must use Vercel's canonical target, not cname.<PLATFORM_DOMAIN>.
CNAME_TARGET=cname.vercel-dns.com
ENABLE_CRON=false

# --- Client (Vite - must keep the VITE_ prefix to reach the browser) ---
# Platform apex domain used to build store subdomains in the seller PWA.
# Must mirror the API's PLATFORM_DOMAIN; accepts an optional protocol for
# dev (e.g. http://lvh.me:5173). Defaults to didwaghana.com when unset.
VITE_PLATFORM_DOMAIN=didwaghana.com
# Platform contact phone (E.164 or spaced; drives the Contact Us page links).
# Falls back to a placeholder when unset.
# VITE_PLATFORM_PHONE=+233 20 123 4567

# --- Neon PostgreSQL ---
DATABASE_URL=postgresql://user:password@ep-cool-name-123456.eu-west-2.aws.neon.tech/didwa?sslmode=require

# --- 2-Way Payments: MTN MoMo API (primary for MTN numbers) ---
# https://momodeveloper.mtn.com/
# MTN numbers (024/025/053/054/055/059) are charged/paid via MTN first;
# Telecel/Vodafone + AT numbers go straight to Hubtel, which is also the
# one-time fallback when the MTN leg fails, errors, times out, or is still
# pending after polling. Leave MTN_* empty to run MTN in dry-run (simulated
# success) - Hubtel still handles non-MTN traffic per its own keys below.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_COLLECTION_USER_ID=
MTN_MOMO_COLLECTION_API_KEY=
# Optional: separate disbursement API user; defaults to the collection user.
# MTN_MOMO_DISBURSEMENT_USER_ID=
# MTN_MOMO_DISBURSEMENT_API_KEY=
# `sandbox` for testing, `mtn-ghana` for live traffic.
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
# MTN_MOMO_PARTY_ID_TYPE=MSISDN
# MTN_MOMO_CURRENCY=GHS
# Set false to disable the automatic Hubtel retry after MTN failures.
PAYMENT_FALLBACK_ENABLED=true

# --- Hubtel (fallback provider + Telecel/AT traffic) ---
# https://developers.hubtel.com/
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=
HUBTEL_CALLBACK_URL=https://didwaghana.com/api/webhooks/hubtel
# Values: mtn-gh | vodafone-gh | airtigtigo-gh
HUBTEL_DEFAULT_CHANNEL=mtn-gh
# Payout requests at or above this amount require manual admin review (GHS)
RISK_THRESHOLD_GHS=5000

# --- Arkesel SMS ---
# https://arkesel.com/
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=DiDwa

# --- Frontend origin (CORS) ---
CLIENT_URL=http://localhost:5173

# --- Cloudflare for SaaS (Flow A: Custom Hostnames / BYOD) ---
# https://developers.cloudflare.com/cloudflare-for-saas/
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PROXY_IP=104.16.0.1

# --- Openprovider (Flow B: Domain Registration) ---
# https://support.openprovider.nl/hc/en-us/articles/360014534994
OPENPROVIDER_API_URL=https://api.openprovider.eu/v1
OPENPROVIDER_USERNAME=
OPENPROVIDER_PASSWORD=

# --- Hubtel Checkout (Flow B: Domain Purchase) ---
# https://developer.hubtel.com/docs
HUBTEL_CHECKOUT_BASE_URL=https://api.hubtel.com

# --- Domain Pricing ---
# Wholesale-to-retail multiplier (1.25 = 25% margin). Prices rounded to nearest 5 GHS.
DOMAIN_MARGIN=1.25

# ============================================================
# VERCEL DEPLOYMENT
# Set these in Project Settings -> Environment Variables.
# ============================================================

# Protects GET /api/cron/billing (the path vercel.json registers; hit daily).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# --- Platform administrator bootstrap ---
# These are optional inputs for `npm run admin:create` only. The running
# application does not read them; the created account is stored as a bcrypt
# hash in the platform_admins table. Do not keep a production password here.
ADMIN_EMAIL=admin@didwaghana.com
ADMIN_PASSWORD=use-a-password-of-at-least-10-characters
ADMIN_NAME=Platform Administrator

# Serverless tip: on Vercel use Neon's POOLED connection string (host contains
# `-pooler`) so many function instances share a small connection budget.
# DATABASE_URL=postgresql://user:password@ep-cool-name-123456-pooler.eu-west-2.aws.neon.tech/didwa?sslmode=require
PGPOOL_MAX=3

# --- Production domain (didwaghana.com on Vercel + Cloudflare DNS) ---
# Apex A      didwaghana.com  -> 76.76.21.21 (use the value on the Vercel
#                                  domain card; remove any AAAA records)
# www CNAME   www             -> cname.vercel-dns.com
# Wildcard    *.didwaghana.com -> proxied through Cloudflare (orange cloud)
#                                  so Cloudflare Universal SSL covers storefront
#                                  subdomains. Vercel-issued wildcard certs
#                                  require delegating the zone to
#                                  ns1/ns2.vercel-dns.com instead.
#PLATFORM_DOMAIN=didwaghana.com
#VITE_PLATFORM_DOMAIN=didwaghana.com
#PLATFORM_URL=https://didwaghana.com
#CNAME_TARGET=cname.vercel-dns.com
