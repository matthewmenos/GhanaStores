# ---- Server ----
PORT=4000
NODE_ENV=development
APP_NAME="Ghana Stores"
APP_BASE_DOMAIN=ghanastores.com
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---- Neon PostgreSQL ----
# Get this from your Neon project dashboard (pooled connection string)
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/ghana_stores?sslmode=require

# ---- Hubtel (Payments + MoMo Disbursements) ----
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret
HUBTEL_MERCHANT_ACCOUNT_NUMBER=your_hubtel_merchant_number
HUBTEL_CALLBACK_URL=https://api.ghanastores.com/api/payouts/webhook
HUBTEL_BASE_URL=https://api.hubtel.com

# ---- Arkesel (Transactional SMS) ----
ARKESEL_API_KEY=your_arkesel_api_key
ARKESEL_SENDER_ID=GhanaStores
ARKESEL_BASE_URL=https://sms.arkesel.com/api/v2

# ---- Billing ----
TRIAL_LENGTH_DAYS=14
GRACE_PERIOD_DAYS=3
PAYOUT_AUTO_APPROVE_THRESHOLD_GHS=5000

# ---- Domain routing ----
SSL_PROVIDER=caddy
